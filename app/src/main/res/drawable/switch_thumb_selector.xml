<?xml version="1.0" encoding="utf-8"?>
<!-- Switch thumb, paired with switch_track_selector. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true"
        android:drawable="@drawable/switch_thumb_on_disable" />
    <item android:state_enabled="false" android:drawable="@drawable/switch_thumb_off_disable" />
    <item android:state_checked="true" android:drawable="@drawable/switch_thumb_on" />
    <item android:drawable="@drawable/switch_thumb_off" />
</selector>
