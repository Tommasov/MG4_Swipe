<?xml version="1.0" encoding="utf-8"?>
<!-- Switch track, taken from the vehicle's own system-settings app so toggles match the
     native ones. Day and night variants ship alongside. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true"
        android:drawable="@drawable/switch_track_on_disable" />
    <item android:state_enabled="false" android:drawable="@drawable/switch_track_off_disable" />
    <item android:state_checked="true" android:drawable="@drawable/switch_track_on" />
    <item android:drawable="@drawable/switch_track_off" />
</selector>
