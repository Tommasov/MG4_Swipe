<?xml version="1.0" encoding="utf-8"?>
<!-- Native-style button face: rounded at the same radius the factory settings app uses, with
     the pressed state carrying the feedback instead of a ripple, so it reads the same on the
     head unit as the stock controls do. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_surface_pressed" />
            <stroke android:width="1dp" android:color="@color/button_border" />
            <corners android:radius="@dimen/button_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_surface" />
            <stroke android:width="1dp" android:color="@color/button_border" />
            <corners android:radius="@dimen/button_radius" />
        </shape>
    </item>
</selector>
