<?xml version="1.0" encoding="utf-8"?>
<!-- 1778x720, read from the driving position. Two columns rather than one, the way MG4 360
     Camera lays out its settings: at this type size a single column runs past the bottom of
     the screen while leaving two thirds of the width empty — which is exactly what happened to
     the first attempt at this screen, and it took the help bars over the edge with it.

     The system-apps button floats in the top right rather than sitting in a header row of its
     own. A full-width header was tried and cost a band of height across both columns, which on
     a 720px screen is a row of the list — the button is a corner action, so it lives in the
     corner instead of pushing the work down.

     The bars are pinned outside the scrolling area, edge to edge, where they have always been:
     they are a map of the bottom of the screen, so they have to sit on the thing they map. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingTop="@dimen/screen_padding">

            <!-- Left: what this is, and the switches. Scrolls on its own so a label that wraps
                 onto two lines cannot push anything off the screen. -->
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/title_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/version_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/button_gap"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/secondary_text_size" />
                    </LinearLayout>

                    <TextView
                        style="@style/SectionHeader"
                        android:text="@string/section_options" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_back_button"
                        style="@style/Choice"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:minHeight="@dimen/row_height"
                        android:text="@string/nascondi_il_bottone_indietro_utile_per_i_tagliandi"
                        android:thumb="@drawable/switch_thumb_selector"
                        app:switchPadding="@dimen/switch_padding"
                        app:track="@drawable/switch_track_selector" />

                    <TextView
                        style="@style/Hint"
                        android:text="@string/hide_back_button_summary" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_swap_areas"
                        style="@style/Choice"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:minHeight="@dimen/row_height"
                        android:text="@string/swap_swipe_areas"
                        android:thumb="@drawable/switch_thumb_selector"
                        app:switchPadding="@dimen/switch_padding"
                        app:track="@drawable/switch_track_selector" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_show_loader"
                        style="@style/Choice"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:minHeight="@dimen/row_height"
                        android:text="@string/show_loader"
                        android:thumb="@drawable/switch_thumb_selector"
                        app:switchPadding="@dimen/switch_padding"
                        app:track="@drawable/switch_track_selector" />
                </LinearLayout>
            </ScrollView>

            <!-- A rule rather than empty space alone: at this width two columns of text with a
                 gap between them read as one ragged column, and the eye needs telling where one
                 ends. -->
            <View
                android:layout_width="@dimen/column_rule_width"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/column_gap"
                android:layout_marginEnd="@dimen/column_gap"
                android:background="@color/column_rule" />

            <!-- Wider than the left, because the list is what this screen is for and the three
                 switches beside it were leaving half a column of empty grey. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionHeader"
                    android:layout_marginTop="0dp"
                    android:text="@string/section_target" />

                <!-- Kept clear of the floating button by an end margin of its width, so a long
                     translation wraps instead of running underneath it. -->
                <TextView
                    android:id="@+id/explanation_text"
                    style="@style/Hint"
                    android:layout_marginEnd="@dimen/corner_action_clearance"
                    android:text="@string/explanation_text" />

                <TextView
                    android:id="@+id/app_list_empty"
                    style="@style/Hint"
                    android:visibility="gone" />

                <ListView
                    android:id="@+id/app_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/row_gap"
                    android:divider="@color/hairline"
                    android:dividerHeight="@dimen/hairline_height" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/toggle_system_apps_button"
            style="@style/TonalButtonCompact"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:text="@string/show_system_apps" />
    </FrameLayout>

    <!-- Exactly where they have always been: the last thing in the window, full width, two
         equal halves, 40dp tall. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/help_back_area"
            android:gravity="center"
            android:text="@string/help_swipe_up_here_to_go_back_this_simulate_the_physical_back_button"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/help_open_area"
            android:gravity="center"
            android:text="@string/help_swipe_up_here_to_open_selected_app"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
