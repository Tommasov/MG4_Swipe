<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_home"
    android:orientation="vertical"
    android:paddingTop="40dp">

    <!-- The launch experiment lives in this screen: a button to cycle the strategy and the
         log of what each one cost. Instrumentation, never shipped. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="200dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/version_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="12dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/button_send_report"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="12dp"
            android:text="@string/report_send"
            android:textSize="12sp" />

        <Button
            android:id="@+id/button_launch_strategy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="12dp"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/boot_timing_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="12dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/toggle_system_apps_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/show_system_apps"
            android:textSize="20sp" />

        <Switch
            android:id="@+id/switch_back_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/nascondi_il_bottone_indietro_utile_per_i_tagliandi"
            android:textAlignment="viewEnd"
            android:textSize="16sp"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="200dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/switch_swap_areas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/swap_swipe_areas"
            android:textSize="16sp"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

        <Switch
            android:id="@+id/switch_show_loader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/show_loader"
            android:textAlignment="viewEnd"
            android:textSize="16sp"
            tools:ignore="UseSwitchCompatOrMaterialXml" />
    </LinearLayout>

    <TextView
        android:id="@+id/explanation_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="200dp"
        android:layout_marginBottom="16dp"
        android:text="@string/explanation_text"
        android:textSize="30sp" />

    <ListView
        android:id="@+id/app_list"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginHorizontal="200dp"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/launch_log_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="200dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:background="@color/help_back_area"
            android:gravity="center_horizontal|center_vertical"
            android:text="@string/help_swipe_up_here_to_go_back_this_simulate_the_physical_back_button"
            android:textAlignment="gravity"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:background="@color/help_open_area"
            android:gravity="center_horizontal|center_vertical"
            android:text="@string/help_swipe_up_here_to_open_selected_app"
            android:textAlignment="gravity"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </LinearLayout>

</LinearLayout>
