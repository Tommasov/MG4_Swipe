<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- DIAGNOSTIC BRANCH ONLY — must not reach master.
         This app has never asked for the network, and that is part of what makes it easy to
         trust: two invisible strips and a button, with no way out. The permission is here so
         that a launch experiment run in a moving car can be sent home in one press instead of
         transcribed from a photograph of the screen. See ProbeReport. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MG4SwipeNovaLauncher">

        <activity android:name=".PermissionActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" />

        <service
            android:name=".SwipeService"
            android:exported="false" />

        <service
            android:name=".AccService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- directBootAware only so that LOCKED_BOOT_COMPLETED can be timestamped: it
             arrives before the credential storage is unlocked, and a receiver that is not
             direct-boot aware never sees it. Nothing is started from there — the service is
             not direct-boot aware and its preferences would not be readable yet. The two
             timings exist to show whether moving the real start to the earlier broadcast
             would recover any of the ten seconds the gesture is dead after a cold boot. -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>